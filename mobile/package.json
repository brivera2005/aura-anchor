{
  "name": "aura-anchor-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor native shell for Aura & Anchor",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "assets": "npx @capacitor/assets generate --ios --android",
    "sync": "npm run icons && npm run assets && cap sync && node scripts/configure-deep-links.mjs",
    "ios": "cap open ios",
    "android": "cap open android",
    "doctor": "cap doctor",
    "add:platforms": "cap add ios && cap add android"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/ios": "^7.4.2",
    "@capacitor/splash-screen": "^7.0.2",
    "@capacitor/status-bar": "^7.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^7.4.2",
    "sharp": "^0.34.2",
    "typescript": "^5"
  }
}

# Supabase

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_SERVICE_ROLE_KEY=your-service-role-key



# App URL (used for invite links)

NEXT_PUBLIC_APP_URL=http://localhost:3000



# Encryption (32-byte hex string for AES-256)

ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef



# AI (optional — app uses mock AI if none are set; Gemini preferred when both are set)

GOOGLE_AI_API_KEY=your-gemini-api-key

# GEMINI_API_KEY=your-gemini-api-key

# OPENAI_API_KEY=sk-your-openai-key



# Email (optional — invite links shown in UI if not configured)

# RESEND_API_KEY=re_your_key

# INVITE_FROM_EMAIL=invites@yourdomain.com



# Admin (comma-separated emails that bypass paywall — optional)

# ADMIN_EMAILS=owner@example.com



# Stripe (required for production subscriptions)

STRIPE_SECRET_KEY=sk_test_your_secret_key

STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

STRIPE_PRICE_ID=price_your_monthly_price_id

STRIPE_LIFETIME_PRICE_ID=price_your_lifetime_price_id

# STRIPE_ANNUAL_PRICE_ID=price_your_annual_price_id

NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key



# Stripe display (defaults: $14.99/mo, $449 lifetime, $119/yr — no free trial)

NEXT_PUBLIC_SUBSCRIPTION_PRICE=14.99

NEXT_PUBLIC_LIFETIME_PRICE=449

NEXT_PUBLIC_ANNUAL_PRICE=119


{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "aura-anchor",
	"compatibility_date": "2026-06-15",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "aura-anchor"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"vars": {
		"NEXT_PUBLIC_APP_URL": "https://your-app.your-subdomain.workers.dev",
		"NEXT_PUBLIC_SUPABASE_URL": "https://your-project.supabase.co",
		"ADMIN_EMAILS": "owner@example.com",
		"STRIPE_PRICE_ID": "price_your_monthly",
		"STRIPE_LIFETIME_PRICE_ID": "price_your_lifetime",
		"STRIPE_ANNUAL_PRICE_ID": "price_your_annual",
		"NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "pk_test_your_publishable_key",
		"NEXT_PUBLIC_SUBSCRIPTION_PRICE": "14.99",
		"NEXT_PUBLIC_LIFETIME_PRICE": "449",
		"NEXT_PUBLIC_ANNUAL_PRICE": "119"
	}
}
